{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stlc-platform.dev/stlc_config.schema.json",
  "title": "STLC Platform Configuration",
  "description": "JSON Schema for config/stlc_config.yaml validation. Generated from the canonical config structure.",
  "type": "object",
  "properties": {
    "project": {
      "type": "object",
      "description": "Project-level settings",
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable project name",
          "default": "My Application"
        },
        "domain": {
          "type": "string",
          "description": "Application domain (auto-detected from requirements if empty)",
          "default": ""
        },
        "tech_stack": {
          "type": "object",
          "description": "Technology stack of the application under test",
          "properties": {
            "platform": {
              "type": "string",
              "enum": ["web", "mobile", "api", "desktop"],
              "default": "web"
            },
            "frontend": {
              "type": "string",
              "description": "Frontend framework (react, angular, vue, flutter, native, or empty)",
              "default": ""
            },
            "backend": {
              "type": "string",
              "enum": ["rest", "graphql", "grpc", "soap"],
              "default": "rest"
            },
            "database": {
              "type": "string",
              "description": "Database technology (postgres, mysql, mongo, dynamodb, or empty)",
              "default": ""
            },
            "auth": {
              "type": "string",
              "description": "Authentication method (jwt, oauth2, session, saml, or empty)",
              "default": ""
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "description": "LLM provider configuration",
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["ollama", "openai", "anthropic", "azure"],
          "default": "ollama",
          "description": "LLM provider to use"
        },
        "model": {
          "type": "string",
          "description": "Model name (e.g., phi4-mini:3.8b, gpt-4o, claude-3-sonnet)",
          "default": "phi4-mini:3.8b"
        },
        "base_url": {
          "type": "string",
          "format": "uri",
          "description": "Provider base URL (Ollama only)",
          "default": "http://localhost:11434"
        },
        "temperature": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 2.0,
          "default": 0.6
        },
        "num_ctx": {
          "type": "integer",
          "minimum": 1024,
          "description": "Context window size in tokens",
          "default": 8192
        },
        "timeout": {
          "type": "integer",
          "minimum": 10,
          "description": "Request timeout in seconds",
          "default": 450
        },
        "num_predict": {
          "type": "integer",
          "minimum": 256,
          "description": "Maximum tokens to generate",
          "default": 3200
        },
        "api_key": {
          "type": "string",
          "description": "API key for cloud providers (or set STLC_LLM__API_KEY env var)",
          "default": ""
        }
      },
      "required": ["provider", "model"],
      "additionalProperties": false
    },
    "chromadb": {
      "type": "object",
      "description": "ChromaDB vector store configuration",
      "properties": {
        "persist_directory": {
          "type": "string",
          "default": "./chroma_db"
        },
        "collection_name": {
          "type": "string",
          "default": "requirements"
        },
        "embedding_backend": {
          "type": "string",
          "enum": ["ollama", "sentence_transformer"],
          "default": "ollama"
        },
        "ollama_embedding_model": {
          "type": "string",
          "default": "qwen3-embedding:0.6b"
        },
        "ollama_embedding_url": {
          "type": "string",
          "format": "uri",
          "default": "http://localhost:11434/api/embeddings"
        },
        "sentence_transformer_model": {
          "type": "string",
          "default": "all-MiniLM-L6-v2"
        }
      },
      "additionalProperties": false
    },
    "test_generation": {
      "type": "object",
      "description": "Test case generation settings",
      "properties": {
        "max_per_requirement": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 6
        },
        "include_negative": {
          "type": "boolean",
          "default": true
        },
        "include_edge_cases": {
          "type": "boolean",
          "default": true
        },
        "format": {
          "type": "string",
          "enum": ["gherkin", "structured", "plain"],
          "default": "gherkin"
        }
      },
      "additionalProperties": false
    },
    "bdd": {
      "type": "object",
      "description": "BDD code generation settings (Stage 2)",
      "properties": {
        "language": {
          "type": "string",
          "enum": ["python", "java", "javascript", "csharp"],
          "default": "python"
        },
        "framework": {
          "type": "string",
          "enum": ["behave", "pytest_bdd", "cucumber", "cucumber_js", "specflow"],
          "default": "behave"
        },
        "automation_lib": {
          "type": "string",
          "enum": ["selenium", "playwright", "cypress", "requests", "rest_assured"],
          "default": "playwright"
        }
      },
      "additionalProperties": false
    },
    "crawler": {
      "type": "object",
      "description": "Web crawler settings (Stage 3)",
      "properties": {
        "base_url": {
          "type": "string",
          "default": ""
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3
        },
        "max_pages": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "wait_for_network_idle": {
          "type": "boolean",
          "default": true
        },
        "respect_robots_txt": {
          "type": "boolean",
          "default": true
        },
        "rate_limit_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 1000
        },
        "auth": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": ["form", "oauth", "bearer", "none", ""],
              "default": ""
            },
            "login_url": { "type": "string", "default": "" },
            "username": { "type": "string", "default": "" },
            "password": { "type": "string", "default": "" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "api_testing": {
      "type": "object",
      "description": "API test generation settings (Stage 3)",
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["pytest_requests", "rest_assured", "karate", "supertest"],
          "default": "pytest_requests"
        },
        "openapi_spec": {
          "type": "string",
          "description": "Path to OpenAPI/Swagger spec file",
          "default": ""
        },
        "base_url": {
          "type": "string",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "description": "Export settings",
      "properties": {
        "output_dir": {
          "type": "string",
          "default": "./output"
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["csv", "zephyr", "json"]
          },
          "default": ["csv", "zephyr", "json"]
        },
        "zephyr": {
          "type": "object",
          "properties": {
            "project_key": { "type": "string", "default": "PROJ" },
            "folder_prefix": { "type": "string", "default": "Generated Tests" },
            "default_status": { "type": "string", "default": "Draft" },
            "default_labels": { "type": "string", "default": "automated,generated" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
