# ── Ollama / LLM ──────────────────────────────────────────────────────────────
# RECOMMENDED MODEL: phi4-mini:3.8b
#   - 2.4GB RAM, ~25 tok/s on CPU (vs ~15 tok/s for qwen2 7B)
#   - Best structured JSON output quality per parameter count of any sub-4B model
#   - Fewer hallucinated loops than qwen2 7B; better schema adherence
#   - Pull: ollama pull phi4-mini:3.8b
#
# ALTERNATIVE: qwen3:8b
#   - Drop-in upgrade from qwen2:7b; better instruction following
#   - Richer descriptions but slower (~13 tok/s on CPU)
#   - Pull: ollama pull qwen3:8b
#
# DO NOT USE 14B models (phi4:14b, qwen2.5:14b) on 16GB RAM + CPU:
#   - They fit in RAM but generate at ~6 tok/s = ~400s per TC = 11+ hours for 102 TCs

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini:3.8b
OLLAMA_TEMPERATURE=0.6
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=450                # Raised from 300 — phi4-mini is fast but 450 gives headroom
OLLAMA_NUM_PREDICT=3200           # Raised from 2400 — eliminates truncated JSON on 5-step TCs

# ── ChromaDB Embedding ────────────────────────────────────────────────────────
# "ollama" = use OllamaEmbeddingFunction (recommended — same server as LLM)
EMBEDDING_BACKEND=ollama
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embeddings

# Sentence-transformer fallback (used if EMBEDDING_BACKEND=sentence_transformer)
ST_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ChromaDB Storage ──────────────────────────────────────────────────────────
# Three collections are used:
#   requirements   — requirement embeddings for cross-requirement context
#   tc_examples    — approved test cases used as few-shot examples (PERSISTS across runs)
#   domain_vocab   — extracted screen/field names for dynamic component resolution
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=requirements

# ── Test Generation ───────────────────────────────────────────────────────────
MAX_TC_PER_REQ=6
INCLUDE_NEGATIVE=true
INCLUDE_EDGE=true
TC_FORMAT=gherkin

# ── Output ────────────────────────────────────────────────────────────────────
OUTPUT_DIR=./output
