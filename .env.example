# STLC Platform Configuration
# Copy to .env and customize

# Server
STLC_PORT=8000

# Authentication (set to true to require JWT/API key)
STLC_AUTH_ENABLED=false
STLC_JWT_SECRET=change-this-to-a-random-string
STLC_ADMIN_USER=admin
STLC_ADMIN_PASSWORD=admin
STLC_API_KEYS=

# LLM
STLC_LLM__MODEL=phi4-mini:3.8b
STLC_LLM__BASE_URL=http://localhost:11434

# Ollama
OLLAMA_PORT=11434
